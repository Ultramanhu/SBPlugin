{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(?i)^\\s*(if\\b.*\\bthen|for\\b.*\\bto|while\\b|sub\\b).*?$",
    "decreaseIndentPattern": "(?i)^\\s*(endif|endfor|endwhile|endsub|else|elseif)\\b.*?$"
  },
  "wordPattern": "[^\\s\\(\\)\\[\\],.:+\-*/=<>']+"
}
